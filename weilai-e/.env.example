# 「未来鹅」环境变量模板
# 本地运行时，复制为 .env 并填入有效值；Streamlit Cloud 部署时使用 .streamlit/secrets.toml

# LLM 接入（兼容 OpenAI 协议，支持 DeepSeek/通义/本地 vLLM 等）
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7

# Embedding（默认走本地 sentence-transformers，可留空）
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# 数据路径
KNOWLEDGE_BASE_DIR=data/knowledge_base
VECTOR_STORE_DIR=data/vector_store
MEMORY_DIR=memory/store
